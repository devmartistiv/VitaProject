<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".nutrition.ui.NutritionAnalyticsActivity">

    <!-- Верхняя панель с аппбаром -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/colorPrimary"
            app:cardCornerRadius="24dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton

                    android:id="@+id/back_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Назад"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="301dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <ImageButton
                        android:id="@+id/date_prev_button"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Предыдущий день"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:drawablePadding="6dp"
                        android:drawableTint="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:text="30 мая 2025"
                        app:tint="@android:color/white"
                        android:textSize="18sp" />

                    <ImageButton
                        android:id="@+id/date_next_button"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Следующий день"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/settings_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Настройки отслеживания"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Индикатор загрузки -->
            <ProgressBar
                android:id="@+id/loading_indicator"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <!-- Карточка с кольцевым прогрессом для калорий -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"

                    android:paddingHorizontal="15dp"
                    android:paddingVertical="24dp"

                    >

                    <!-- Заголовок карточки -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Калории"

                            android:src="@drawable/ic_fire"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Потребленные калории"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Круговой индикатор прогресса -->
                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circular_calories_progress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:progress="0"
                            app:indicatorTrackGapSize="0dp"
                            app:indicatorColor="@color/colorAccent"
                            app:indicatorSize="200dp"
                            app:trackColor="@color/progress_track_color_light"

                            app:trackThickness="18dp" />

                        <!-- Только основное число калорий -->
                        <TextView
                            android:id="@+id/calories_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1180"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="44sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Информация о норме с процентами -->
                    <TextView
                        android:id="@+id/calories_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="из 2776 ккал (42%)"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="22sp" />

                    <!-- Секция БЖУ с круговыми прогресс-барами -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="20dp"
                            android:background="?android:attr/dividerHorizontal" />

                        <!-- БЖУ в горизонтальном ряду -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <!-- Белки -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Белки"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="18sp" />

                                <FrameLayout
                                    android:layout_width="90dp"
                                    android:layout_height="20dp"
                                    android:layout_marginBottom="4dp">

                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/proteins_progress"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        app:trackStopIndicatorSize="0dp"
                                        android:progress="13"
                                        app:indicatorColor="@color/proteins_text_color"
                                        app:indicatorSize="90dp"
                                        app:trackColor="@color/progress_track_color_light"
                                        app:trackCornerRadius="4dp"
                                        app:trackThickness="8dp" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/proteins_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="17.9/135г"
                                    android:textColor="@color/proteins_text_color"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Жиры -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Жиры"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="18sp" />

                                <FrameLayout
                                    android:layout_width="90dp"
                                    android:layout_height="20dp"
                                    android:layout_marginBottom="4dp">

                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/fats_progress"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:progress="3"
                                        app:trackStopIndicatorSize="0dp"
                                        app:indicatorColor="@color/fats_text_color"
                                        app:indicatorSize="90dp"
                                        app:trackColor="@color/progress_track_color_light"
                                        app:trackCornerRadius="4dp"
                                        app:trackThickness="8dp" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/fats_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3.7/118г"
                                    android:textColor="@color/fats_text_color"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Углеводы -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Углеводы"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="18sp" />

                                <FrameLayout
                                    android:layout_width="90dp"
                                    android:layout_height="20dp"
                                    android:layout_marginBottom="4dp">

                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/carbs_progress"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:progress="1"
                                        app:indicatorColor="@color/carbs_text_color"
                                        app:indicatorSize="90dp"
                                        app:trackStopIndicatorSize="0dp"
                                        app:trackColor="@color/progress_track_color_light"
                                        app:trackCornerRadius="4dp"
                                        app:trackThickness="8dp" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/carbs_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5.3/660г"
                                    android:textColor="@color/carbs_text_color"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Секция с витаминами -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Витамины"
                            android:src="@drawable/ic_vitamin"
                            android:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Витамины"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vitamins_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Элементы будут добавлены программно -->

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Секция с минералами -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Минералы"
                            android:src="@drawable/ic_mineral"
                            android:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Минералы"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/minerals_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Элементы будут добавлены программно -->

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Секция с дополнительными нутриентами -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Дополнительные нутриенты"
                            android:src="@drawable/ic_nutrients"
                            android:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Дополнительные нутриенты"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/additional_nutrients_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Элементы будут добавлены программно -->

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 