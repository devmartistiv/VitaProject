<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/profile_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Иконка части тела -->
        <ImageView
            android:id="@+id/bodyPartIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_biceps"
            android:layout_marginEnd="16dp"
            app:tint="@color/colorPrimary" />

        <!-- Информация о замере -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bodyPartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Бицепс левый"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/profile_text_primary" />

            <TextView
                android:id="@+id/lastMeasurementDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Последний замер: 15 янв"
                android:textSize="12sp"
                android:textColor="@color/profile_text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Текущее значение -->
        <TextView
            android:id="@+id/currentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32.5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/profile_text_primary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="см"
            android:textSize="14sp"
            android:textColor="@color/profile_text_secondary"
            android:layout_marginEnd="12dp" />

        <!-- Изменение -->
        <LinearLayout
            android:id="@+id/changeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_background_change"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/trendIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="#4CAF50"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/changeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <!-- Стрелка для детального просмотра -->
        <ImageView
            android:id="@+id/detailsArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/profile_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
