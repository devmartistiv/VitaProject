<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/profile_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Левая часть с датой и заметкой -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/measurementDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 января"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/profile_text_primary" />

            <TextView
                android:id="@+id/measurementNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="После тренировки"
                android:textSize="12sp"
                android:textColor="@color/profile_text_secondary"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Значение замера -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/measurementValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32.5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/profile_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="см"
                android:textSize="14sp"
                android:textColor="@color/profile_text_secondary"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Изменение относительно предыдущего -->
        <LinearLayout
            android:id="@+id/changeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_background_change"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/changeIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="#4CAF50"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/changeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
