<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:title="Выбор ингредиентов"
        app:titleTextColor="@color/textColorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/textColorPrimary" />

    <!-- Поиск и сканирование -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/dividerColor">

            <android.widget.SearchView
                android:id="@+id/search_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:iconifiedByDefault="false"
                android:queryHint="Поиск продуктов"/>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/barcode_scan_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_barcode"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorAccent"
            android:contentDescription="Сканировать штрихкод"/>

    </LinearLayout>

    <!-- Сообщение об отсутствии результатов -->
    <TextView
        android:id="@+id/empty_results_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="По данному запросу ничего не найдено"
        android:textAlignment="center"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginTop="48dp"
        android:visibility="gone"
        android:textColor="@color/textColorPrimary"/>

    <!-- Список продуктов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/food_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"/>

    <!-- Нижняя панель с выбранными ингредиентами -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:padding="16dp"
        android:layout_gravity="bottom">

        <!-- Счетчик выбранных -->
        <TextView
            android:id="@+id/selected_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрано: 0"
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Кнопка добавления -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_selected"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Добавить"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            android:layout_gravity="bottom"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>