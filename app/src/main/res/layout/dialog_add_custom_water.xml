<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"

    android:padding="24dp">

    <!-- Заголовок с иконкой -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/water_blue"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Добавить воду"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/textColorPrimary" />
    </LinearLayout>

    <!-- Поле количества воды -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_water_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/water_blue"
        android:textColorHint="@color/water_blue"
        app:hintTextColor="@color/water_blue"
        app:startIconDrawable="@drawable/ic_water_drop"
        app:startIconTint="@color/water_blue"
        app:suffixText="мл"
        app:suffixTextColor="@color/textColorSecondary"
        app:helperText="Введите количество от 10 до 2000 мл"
        app:helperTextTextColor="@color/textColorSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_water_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Количество воды"
            android:inputType="number"
            android:textSize="16sp"
            android:fontFamily="sans-serif" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле описания -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:boxStrokeColor="@color/water_blue"
        android:textColorHint="@color/water_blue"
        app:hintTextColor="@color/water_blue"
        app:startIconDrawable="@drawable/ic_note"
        app:startIconTint="@color/water_blue"
        app:helperText="Необязательно"
        app:helperTextTextColor="@color/textColorSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Примечание"
            android:inputType="textCapSentences"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Быстрые кнопки -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Или выберите быстрый вариант:"
        android:textSize="14sp"
        android:textColor="@color/textColorSecondary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_250"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="250 мл"
            android:textSize="14sp"
            app:backgroundTint="#1A4FC3F7"
            app:strokeColor="@color/water_blue"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_500"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="500 мл"
            android:textSize="14sp"
            app:backgroundTint="#1A4FC3F7"
            app:strokeColor="@color/water_blue"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>
</LinearLayout>
