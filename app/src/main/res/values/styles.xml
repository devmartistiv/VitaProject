<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="Theme.VitaMove.NoActionBar" parent="Theme.VitaMove">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!-- Пользовательский стиль для фильтрующих чипов -->
    <style name="Widget.VitaMove.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">14sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="rippleColor">@color/colorAccent</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/accent_color</item>
        <item name="checkedIconVisible">false</item>
        <item name="checkedIconEnabled">false</item>
    </style>

    <!-- Стиль для текста выбранного чипа удалён, так как атрибут checkedTextAppearance не поддерживается -->

    <!-- Стиль для заголовка тулбара -->
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/gray_900</item>
    </style>

    <style name="MealCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#E0E0E0</item>
    </style>

    <style name="MealCardContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="MealTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#030303</item>
    </style>

    <style name="MealSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#757575</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="AddFoodButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">ДОБАВИТЬ ЕДУ</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="RoundButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fabSize">mini</item>
        <item name="backgroundTint">@color/accent_color</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="WeekDayStyle">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#757575</item>
        <item name="android:background">@drawable/day_circle_background</item>
    </style>

    <style name="InactiveInputField">
        <item name="android:textColor">@color/gray_600</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@null</item>
        <item name="android:enabled">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Стили для календаря -->
    <style name="CalendarHeader" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="CalendarDateText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/gray_900</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CalendarWeekText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gray_600</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Стиль для стандартной кнопки в приложении -->
    <style name="Widget.VitaMove.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/accent_color</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Стиль для кнопки с контуром -->
    <style name="Widget.VitaMove.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_color</item>
        <item name="strokeColor">@color/accent_color</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Стиль для кнопки "Начать" на экране онбординга -->
    <style name="Widget.VitaMove.Button.Onboarding">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/orange_500</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="icon">@drawable/ic_arrow_right</item>
        <item name="iconGravity">end</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- Стиль для TextInputLayout с корректной обводкой -->
    <!-- Переписать на Material3 пока что возникает ошибка-->
    <style name="Widget.VitaMove.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_input_hint_color</item>
        <item name="android:textColorHint">@color/text_input_hint_color</item>
        <item name="endIconTint">@color/orange_500</item>
        <item name="startIconTint">@color/orange_500</item>
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
    </style>

    <!-- Стиль для диалога деталей упражнения -->
    <style name="ThemeOverlay.MaterialComponents.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog">
        <item name="windowMinWidthMajor">@dimen/abc_dialog_min_width_major</item>
        <item name="windowMinWidthMinor">@dimen/abc_dialog_min_width_minor</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Стиль для диалога с деталями упражнения -->
    <style name="ExerciseDetailsDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/ExerciseDialogTitleTextStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/ExerciseDialogBodyTextStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/ExerciseDialogButtonStyle</item>
    </style>

    <!-- Стиль для заголовка диалога с деталями упражнения -->
    <style name="ExerciseDialogTitleTextStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для текста диалога с деталями упражнения -->
    <style name="ExerciseDialogBodyTextStyle" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/gray_800</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Стиль для кнопки диалога с деталями упражнения -->
    <style name="ExerciseDialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">

    </style>

    <!-- Стиль для диалогов с закругленными углами -->
    <style name="CustomDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/CustomAlertDialogStyle</item>
    </style>

    <style name="CustomAlertDialogStyle" parent="MaterialAlertDialog.Material3">
        <item name="android:background">@drawable/custom_dialog_background</item>
    </style>

    <!-- Стиль для ползунка в виде линейки -->

    <!-- Переделать на Material3 -->
    <style name="RulerSeekBarStyle" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/custom_seekbar</item>
        <item name="android:thumbTint">@color/orange_500</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- Стиль для текста в TabLayout -->
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Стиль для современного TabLayout с фоном для табов -->
    <style name="ModernTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@drawable/tab_background_selector</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
        <item name="tabTextColor">@drawable/tab_text_selector</item>
        <item name="tabIndicator">@null</item>
        <item name="tabGravity">center</item>
        <item name="tabInlineLabel">true</item>
        <item name="tabMinWidth">80dp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabPaddingStart">4dp</item>
        <item name="tabPaddingEnd">4dp</item>
        <item name="tabPaddingTop">8dp</item>
        <item name="tabPaddingBottom">8dp</item>
    </style>

    <!-- Стиль для анимированного TabLayout -->
    <style name="AnimatedTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
        <item name="tabTextColor">@drawable/tab_text_selector</item>
        <item name="tabIndicator">@null</item>
        <item name="tabGravity">fill</item>
        <item name="tabInlineLabel">true</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabPaddingStart">0dp</item>
        <item name="tabPaddingEnd">0dp</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabPaddingBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="tabMode">fixed</item>
    </style>

    <!-- Стиль для суффикса в поле ввода размера порции -->
    <style name="SuffixTextAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/textColorSecondary</item>
    </style>

    <!-- Стиль для основной кнопки активной программы -->
    <style name="Widget.VitaMove.Button.ActiveProgram" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">2dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Стиль для второстепенной кнопки активной программы -->
    <style name="Widget.VitaMove.Button.OutlinedActiveProgram" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/accent_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/accent_color</item>
    </style>

    <!-- Стиль для кнопок на экранах опроса -->
    <style name="Widget.VitaMove.Button.Survey">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/orange_500</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <!-- Стиль для кнопки регистрации -->
    <style name="Widget.VitaMove.Button.Register">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/orange_500</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">4dp</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <style name="MaterialAlertDialog_rounded" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <!-- Стиль для кнопки Google при регистрации -->
    <style name="Widget.VitaMove.Button.GoogleRegister">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="backgroundTint">?android:attr/colorBackground</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">4dp</item>
        <item name="icon">@drawable/ic_google_logo</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@null</item>
        <item name="strokeColor">?android:attr/textColorSecondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Стиль для кнопки входа -->
    <style name="Widget.VitaMove.Button.Login">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/orange_500</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">4dp</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <!-- Стиль для карточки статистики -->
    <style name="Widget.VitaMove.Card.Stats" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/ripple_color</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Стиль для заголовка в карточке статистики -->
    <style name="TextAppearance.VitaMove.Card.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для цифр статистики -->
    <style name="TextAppearance.VitaMove.Stats.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для подписей статистики -->
    <style name="TextAppearance.VitaMove.Stats.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <!-- Стиль для элемента последней тренировки -->
    <style name="Widget.VitaMove.Card.Workout" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="rippleColor">@color/orange_200</item>
    </style>

    <!-- Стиль для заголовка на странице -->
    <style name="TextAppearance.VitaMove.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/section_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Стиль для TextInputLayout с выпадающим списком -->
    <style name="Widget.VitaMove.TextInputLayout.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_input_hint_color</item>
        <item name="android:textColorHint">@color/text_input_hint_color</item>
        <item name="endIconTint">@color/accent_color</item>
        <item name="startIconTint">@color/accent_color</item>
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="boxBackgroundMode">outline</item>
    </style>

    <!-- Стиль для SearchView в темной и светлой теме -->
    <style name="SearchViewStyle" parent="Widget.Material3.SearchView">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorSecondary</item>
        <item name="android:queryBackground">@null</item>
        <item name="queryBackground">@null</item>
    </style>

    <!-- Стиль для маскировки водяного знака -->
    <style name="WatermarkHider">
        <item name="android:windowBackground">@drawable/watermark_hider_background</item>
    </style>

    <!-- Тема для активностей с водяным знаком -->
    <style name="Theme.VitaMove.NoActionBar.WatermarkHider" parent="Theme.VitaMove.NoActionBar">
        <item name="android:windowBackground">@drawable/watermark_hider_background</item>
    </style>

    <!-- Стиль для круглых чипов дней недели -->
    <style name="CircularChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAlignment">center</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStartPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.CircularChip</item>
    </style>

    <style name="ShapeAppearanceOverlay.CircularChip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Стиль для BottomSheet диалога -->
    <style name="CustomBottomSheetStyle" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearance">@style/BottomSheetShapeAppearance</item>
    </style>

    <!-- Форма для закругления углов BottomSheet -->
    <style name="BottomSheetShapeAppearance" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Стиль для календаря -->
    <style name="CustomDatePickerStyle" parent="ThemeOverlay.Material3.Dialog">

        <item name="colorAccent">@color/colorPrimary</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:datePickerStyle">@style/CustomDatePicker</item>
    </style>

    <style name="CustomDatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/colorPrimary</item>
        <item name="android:dayOfWeekBackground">@android:color/transparent</item>
        <item name="android:dayOfWeekTextAppearance">
            @style/TextAppearance.VitaMove.DatePicker.DayOfWeek
        </item>
    </style>

    <style name="TextAppearance.VitaMove.DatePicker.DayOfWeek" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Стиль для MaterialAlertDialog -->
    <style name="MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="android:background">@color/card_background</item>
        <item name="android:windowBackground">@color/card_background</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialogTitleStyle</item>
    </style>

    <style name="MaterialAlertDialogTitleStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorGrey</item>
    </style>

    <!-- Стиль для текста в WorkoutTabLayout -->
    <style name="WorkoutTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Стиль для кнопок в header_layout (в fragment_calories) -->
    <style name="Widget.App.HeaderButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="iconTint">@color/colorPrimary</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.App.Gbutton" parent="Widget.Material3.Button">

        <item name="tintMode">add</item>

    </style>

    <!-- Стиль для центральной карточки с названием в header_layout -->
    <style name="Widget.App.HeaderTitleCard" parent="CardView">
        <item name="cardBackgroundColor">#33FFFFFF</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Стиль для текста заголовка в header_layout -->
    <style name="Widget.App.HeaderTitleText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <!-- Стиль для hint текста в инпутах -->
    <style name="HintTextAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <!-- Современный стиль для PopupMenu -->
    <style name="ModernPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:dropDownHorizontalOffset">-12dp</item>
    </style>

    <!-- Стиль для элементов современного PopupMenu -->
    <style name="ModernPopupMenuItem" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?android:attr/colorBackground</item>
        <item name="colorOnSurface">?android:attr/textColorPrimary</item>
        <item name="colorPrimary">@color/accent_color</item>

        <item name="buttonBarPositiveButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="titleTextColor">@color/accent_color</item>
        <item name="shapeAppearanceOverlay">@style/MyDialogCorners</item>

        <!-- Фикс текста: берем системный цвет текста, он сам меняется день/ночь -->
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="MyDialogButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyDialogCorners">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="AppProgressbar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackCornerRadius">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="CircularAppProgressbar" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorTrackGapSize">0dp</item>

        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="ThemeOverlay.MyApp.SpinnerPopup" parent="">
        <item name="dropDownListViewStyle">@style/MySpinnerListStyle</item>
    </style>

    <!-- Сам стиль с линиями -->
    <style name="MySpinnerListStyle" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">#E0E0E0</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

</resources>
