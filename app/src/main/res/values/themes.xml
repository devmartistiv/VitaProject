<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VitaMove" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/colorBackground</item>
        <item name="colorOnPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryContainer">@color/colorBackground</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimary</item>
        <item name="materialCardViewStyle">@style/AppCard</item>
        <item name="materialAlertDialogTheme">@style/MyAlertDialogTheme</item>
        <!-- Secondary -->
        <item name="colorSecondary">#03DAC5</item>

        <item name="colorSecondaryContainer">#A0F2E8</item>
        <item name="colorOnSecondaryContainer">#003731</item>

        <item name="colorSurface">@color/colorBackground</item>
        <item name="linearProgressIndicatorStyle">@style/AppProgressbar</item>
        <item name="circularProgressIndicatorStyle">@style/CircularAppProgressbar</item>
        <item name="colorSurfaceVariant">@color/colorBackground</item>
        <item name="colorOnSurfaceVariant">#49454F</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/accent_color</item>
        <!--        <item name="colorSecondary">@color/accent_color</item>-->
        <item name="android:colorBackground">@color/background_color</item>
        <item name="android:windowBackground">@drawable/app_background</item>
        <!--        <item name="colorPrimaryContainer">@color/colorAccentLight</item>-->

        <!-- Стили для стандартных компонентов -->
        <item name="materialButtonStyle">@style/Widget.VitaMove.Button</item>
        <item name="chipStyle">@style/Widget.VitaMove.Chip.Filter</item>
        <item name="textInputStyle">@style/Widget.VitaMove.TextInputLayout</item>


        <!-- Дополнительные атрибуты для тем -->
        <item name="dividerColor">@color/gray_200</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">0dp</item>
    </style>


    <style name="Theme.VitaMove" parent="Base.Theme.VitaMove">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.VitaMove.splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">
            @color/colorBackground
        </item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>

    </style>

    <style name="OrangeOutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorAccent</item>
        <item name="hintTextColor">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorAccent</item>
    </style>
</resources>